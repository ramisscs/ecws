APP_NAME="ECWS - Sabah Al-Salem"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuwait
APP_URL=https://ecws.sabahalsalem-co.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecws
DB_USERNAME=ecws_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=ecws_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@sabahalsalem-co.com
MAIL_FROM_NAME="نظام المراسلات - جمعية صباح السالم"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="ECWS"

# ECWS Specific
ECWS_PREFIX=SSCS
ECWS_SECRET_TRANSACTIONS_ENABLED=true
ECWS_AI_ENABLED=true
ECWS_AI_PROVIDER=openai
ECWS_AI_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=

# WhatsApp API (Twilio or similar)
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# 2FA
TWO_FACTOR_ENABLED=true

# File Upload
MAX_FILE_SIZE=10240
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,zip

# Audit Log
AUDIT_LOG_RETENTION_DAYS=365
